{% extends '@Contao/form_row.html.twig' %}
{% set invisible_class = invisible_class|default('invisible') %}

{% block field %}
    <fieldset id="ctrl_{{ this.id }}" class="checkbox_container{% if this.class|default %} {{ this.class }}{% endif %}"{% if this.help|default %} aria-describedby="help_ctrl_{{ this.id }}"{% endif %}>
        {% if this.label %}
            <legend>
                {% if this.mandatory|default %}
                    <span class="{{ invisible_class }}">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_raw }}<span class="mandatory">*</span>
                {% else %}
                    {{ this.label|insert_tag_raw }}
                {% endif %}
            </legend>
        {% endif %}

        {% if hasErrors.invoke() %}
            {% set error_element = error_wrapper_element|default(this.error_wrapper_element|default('p')) %}
            {% set error_attributes = attrs()
                .addClass('error')
                .mergeWith(error_wrapper_attributes|default(this.error_wrapper_attributes|default))
            %}
            <{{ error_element }}{{ error_attributes }}>{{ getErrorAsString.invoke() }}</{{ error_element }}>
        {% endif %}

        <input type="hidden" name="{{ this.name }}" value="">

        {% set option = getOption.invoke() %}
        {% set option_element = option_wrapper_element|default(this.option_wrapper_element|default('span')) %}
        {% set option_attributes = attrs()
            .mergeWith(option_wrapper_attributes|default(this.option_wrapper_attributes|default))
        %}
        {% set input_attributes = attrs()
            .set('type', 'checkbox')
            .set('name', option.name)
            .set('id', "opt_#{option.id}")
            .addClass('checkbox')
            .set('value', option.value)
            .set('checked', option.checked, option.checked)
            .mergeWith(option.attributes)
            .mergeWith(checkbox_attributes|default(this.checkbox_attributes|default))
        %}
        {% set option_label_attributes = attrs()
            .set('id', "lbl_#{option.id}")
            .set('for', "opt_#{option.id}")
            .mergeWith(label_attributes|default(this.label_attributes|default))
        %}

        <{{ option_element }}{{ option_attributes }}>
            <input{{ input_attributes }}>
            <label{{ option_label_attributes }}>
                {% if option.mandatory|default %}
                    <span class="{{ invisible_class }}">{{ this.mandatoryField }} </span>{{ option.label|sanitize_html('contao')|insert_tag_raw }}
                    <span class="mandatory">*</span>
                {% else %}
                    {{ option.label|sanitize_html('contao')|insert_tag_raw }}
                {% endif %}
            </label>
        </{{ option_element }}>

        {% if this.help|default %}
            <p class="help" id="help_ctrl_{{ this.id }}">{{ this.help|insert_tag_raw }}</p>
        {% endif %}
    </fieldset>
{% endblock %}
